# ===================
# API Authentication
# ===================

# API Secret Key (required for all authenticated requests)
# Generate with: openssl rand -hex 32
API_SECRET_KEY=your-secret-api-key

# ===================
# Backend
# ===================

# Server
API_PORT=9000
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://postgres:password@localhost:5433/mindhit?sslmode=disable
DEV_DATABASE_URL=postgres://postgres:password@localhost:5433/mindhit_dev?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6380

# Worker
WORKER_CONCURRENCY=10

# ===================
# AI Providers
# ===================
# At least one API key is required for AI features (tag extraction, mindmap generation)
# Groq is recommended for free tier (https://console.groq.com)

GROQ_API_KEY=gsk_...

# Alternative providers (optional)
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIza...
# CLAUDE_API_KEY=sk-ant-...

# ===================
# Docker Services
# ===================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mindhit

# Grafana (optional monitoring)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Alerting (Optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ===================
# Frontend (Next.js)
# ===================

# API URL for client-side requests
# Note: Do NOT include /v1 - the frontend adds it automatically
NEXT_PUBLIC_API_URL=http://localhost:9000

# API Key for frontend (same as API_SECRET_KEY)
NEXT_PUBLIC_API_KEY=your-secret-api-key

# ===================
# Chrome Extension
# ===================

# API URL for extension
# Note: MUST include /v1 - unlike frontend, extension doesn't add it
VITE_API_URL=http://localhost:9000/v1
VITE_WEB_APP_URL=http://localhost:3000

# API Key for extension (same as API_SECRET_KEY)
VITE_API_KEY=your-secret-api-key

# Event batching configuration
# VITE_EVENT_BATCH_SIZE: Number of events to accumulate before sending (default: 1 for dev, 10 for production)
# VITE_EVENT_FLUSH_INTERVAL: Time in ms between automatic flushes (default: 5000 for dev, 30000 for production)
VITE_EVENT_BATCH_SIZE=1
VITE_EVENT_FLUSH_INTERVAL=5000
