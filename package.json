{
  "name": "mindhit",
  "private": true,
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": "22.14.0"
  },
  "scripts": {
    "dev": "moonx :dev",
    "build": "moonx :build",
    "test": "moonx :test",
    "lint": "moonx :lint",
    "ci": "moon ci",
    "generate": "pnpm run generate:protocol && pnpm run generate:api:go && pnpm run generate:api:ts",
    "generate:protocol": "pnpm --filter @mindhit/protocol build",
    "generate:api:go": "cd apps/backend && make generate-api",
    "generate:api:ts": "pnpm --filter @mindhit/web generate"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1.29.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "undici@7": ">=7.28.0 <8",
      "form-data@4": ">=4.0.6 <5",
      "ws@8": ">=8.21.0 <9",
      "fast-uri@3": ">=3.1.2 <4",
      "defu@6": ">=6.1.5 <7",
      "lodash@4": ">=4.17.23 <5",
      "picomatch@2": ">=2.3.2 <3",
      "picomatch@4": ">=4.0.4 <5",
      "flatted@3": ">=3.4.2 <4",
      "minimatch@3": ">=3.1.4 <4",
      "minimatch@9": ">=9.0.7 <10",
      "rollup@2": ">=2.80.0 <3",
      "rollup@4": ">=4.59.0 <5",
      "js-yaml@4": ">=4.2.0 <5",
      "postcss@8": ">=8.5.10 <9",
      "follow-redirects@1": ">=1.16.0 <2",
      "brace-expansion@1": ">=1.1.13 <2",
      "brace-expansion@2": ">=2.0.3 <3",
      "yaml@2": ">=2.8.3 <3",
      "ajv@6": ">=6.14.0 <7",
      "ajv@8": ">=8.18.0 <9",
      "@babel/core@7": ">=7.29.6 <8"
    }
  }
}
